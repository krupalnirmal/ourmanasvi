# ─────────────────────────────────────────────────────────────
# Baby memory book — environment variables
# Every service below is on a FREE tier. Do not swap for paid ones.
# ─────────────────────────────────────────────────────────────

# Whose book is this? These drive every heading, page title and the PWA name,
# so a new site needs no code changes — just fill these in.
NEXT_PUBLIC_BABY_NAME="Manasvi"
# Defaults to "Our<BabyName>" if left out.
NEXT_PUBLIC_SITE_NAME="OurManasvi"
NEXT_PUBLIC_SITE_TAGLINE="A Year of Firsts"
# Defaults to a sensible sentence built from the baby's name.
NEXT_PUBLIC_SITE_DESCRIPTION=""
# Signed off in the footer / contact page. Defaults to "<BabyName>'s Family".
NEXT_PUBLIC_FAMILY_NAME="Manasvi's Family"

# Birth dates — used by the seeder to create months 0–12.
BABY_BIRTH_DATE="2025-07-14"
BABY_FIRST_BIRTHDAY="2026-07-14"

# Cloudinary folder all uploads live under. Give each site its own.
CLOUDINARY_FOLDER="ourmanasvi"

# Colour palette: pink (default) | blue | mint | peach | lavender
# Leave blank or omit for the original pink. See lib/theme.ts to add your own.
SITE_THEME="pink"

# Database — TiDB Cloud Starter (free, MySQL-compatible)
# Copy the connection string from the TiDB Cloud console.
# Example: mysql://<user>:<pass>@gateway01.<region>.prod.aws.tidbcloud.com:4000/ourmanasvi?sslaccept=strict
DATABASE_URL="mysql://user:password@host:4000/ourmanasvi?sslaccept=strict"

# Media — Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Public vars used by the browser for direct (unsigned) uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="ourmanasvi_unsigned"

# Auth — NextAuth v5 / Auth.js (single admin = the parents)
# Generate a fresh AUTH_SECRET per site — never reuse one across sites:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate_with:  openssl rand -base64 32"
ADMIN_EMAIL="parents@example.com"
ADMIN_PASSWORD="change_me"
